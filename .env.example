# Optional. Videos are served from /videos by default. Set this to move
# them to an object store or CDN, for example https://media.example.com/videos
# NEXT_PUBLIC_MEDIA_BASE_URL=

# Optional GA4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Password for case studies marked locked in lib/projects.ts.
# Defaults to hiremegan when unset. This value is not a secret in a public repo.
PORTFOLIO_PASSWORD=hiremegan
